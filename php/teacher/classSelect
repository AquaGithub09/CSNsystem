    /* =========================================
   BASE
========================================= */
    
    * {
      box-sizing: border-box;
    }
    
    body {
      margin: 0;
      background: #f8f9fb;
      font-family: Arial, sans-serif;
      color: #212529;
    }
    
    
    /* =========================================
   TEACHER CONTENT
========================================= */
    
    .teacher-content {
      min-height: 100vh;
      
      display: flex;
      flex-direction: column;
    }
    
    
    /* =========================================
   CLASS SELECTION
========================================= */
    
    .class-selection {
      flex: 1;
      
      width: 100%;
      max-width: 1200px;
      
      margin: 0 auto;
      
      padding: 40px 20px;
    }
    
    
    /* =========================================
   HEADER
========================================= */
    
    .class-selection-header {
      margin-bottom: 30px;
    }
    
    .class-selection-header h2 {
      margin: 0 0 6px;
      
      font-size: 1.7rem;
      font-weight: 700;
    }
    
    .class-selection-header p {
      margin: 0;
      
      color: #6c757d;
      font-size: 0.95rem;
    }
    
    
    /* =========================================
   CLASS GRID
========================================= */
    
    .class-grid {
      display: grid;
      
      grid-template-columns: repeat(2, 1fr);
      
      gap: 16px;
    }
    
    
    /* =========================================
   CLASS PROFILE
========================================= */
    
    .class-profile {
      width: 100%;
      
      border: 1px solid #e5e7eb;
      border-radius: 18px;
      
      background: #ffffff;
      
      padding: 24px 16px;
      
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      
      text-align: center;
      
      cursor: pointer;
      
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease,
        background-color 0.2s ease;
    }
    
    
    /* =========================================
   HOVER
========================================= */
    
    .class-profile:hover {
      transform: translateY(-3px);
      
      border-color: #d7dbe0;
      
      box-shadow:
        0 8px 20px rgba(0, 0, 0, 0.07);
    }
    
    
    /* =========================================
   SELECTED
========================================= */
    
    .class-profile.selected {
      border-color: #0d6efd;
      
      background: #f4f8ff;
      
      box-shadow:
        0 0 0 3px rgba(13, 110, 253, 0.12);
    }
    
    
    /* =========================================
   CLASS AVATAR
========================================= */
    
    .class-avatar {
      width: 90px;
      height: 90px;
      
      border-radius: 50%;
      
      display: flex;
      align-items: center;
      justify-content: center;
      
      margin-bottom: 15px;
      
      font-size: 2rem;
    }
    
    
    /* =========================================
   AVATAR COLORS
========================================= */
    
    .class-avatar.blue {
      background: #e7f1ff;
      color: #0d6efd;
    }
    
    .class-avatar.pink {
      background: #ffe8f0;
      color: #d63384;
    }
    
    .class-avatar.green {
      background: #e6f7ee;
      color: #198754;
    }
    
    .class-avatar.orange {
      background: #fff0df;
      color: #fd7e14;
    }
    
    
    /* =========================================
   CLASS INFO
========================================= */
    
    .class-info h5 {
      margin: 0 0 5px;
      
      font-size: 1rem;
      font-weight: 700;
    }
    
    .class-info span {
      color: #6c757d;
      
      font-size: 0.85rem;
    }
    
    
    /* =========================================
   ADD CLASS
========================================= */
    
    .class-profile.add-class {
      border-style: dashed;
      
      background: #fafafa;
    }
    
    .class-profile.add-class:hover {
      background: #ffffff;
      
      border-color: #0d6efd;
    }
    
    .class-avatar.add {
      background: #eef1f5;
      
      color: #6c757d;
    }
    
    .class-profile.add-class:hover .class-avatar.add {
      background: #e7f1ff;
      
      color: #0d6efd;
    }
    
    

    
    /* =========================================
   TABLET
========================================= */
    
    @media (min-width: 576px) {
      
      .class-grid {
        grid-template-columns: repeat(3, 1fr);
      }
      
    }
    
    
    /* =========================================
   DESKTOP
========================================= */
    
    @media (min-width: 992px) {
      
      .class-selection {
        padding: 55px 30px;
      }
      
      .class-selection-header h2 {
        font-size: 2rem;
      }
      
      .class-grid {
        grid-template-columns: repeat(4, 1fr);
      }
      
    }
    
    
    /* =========================================
   SMALL MOBILE
========================================= */
    
    @media (max-width: 400px) {
      
      .class-selection {
        padding: 30px 15px;
      }
      
      .class-grid {
        gap: 12px;
      }
      
      .class-profile {
        padding: 20px 10px;
      }
      
      .class-avatar {
        width: 75px;
        height: 75px;
        
        font-size: 1.7rem;
      }
      
      .class-info h5 {
        font-size: 0.9rem;
      }
      
      .class-info span {
        font-size: 0.75rem;
      }
      
      .teacher-footer {
        flex-direction: column;
        
        text-align: center;
      }
      
    }
    
    ```
